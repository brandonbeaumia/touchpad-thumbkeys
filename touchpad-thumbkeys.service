[Unit]
Description=Touchpad Thumb Keys Daemon
Documentation=https://github.com/YOUR_USERNAME/touchpad-thumbkeys
# Start after the input subsystem and graphical target are up
After=sys-subsystem-input-devices.device multi-user.target
# Re-evaluate device availability if udev triggers input changes
Wants=sys-subsystem-input-devices.device

[Service]
Type=simple
# Ensure working directory points to your project folder
WorkingDirectory=/usr/local/bin
ExecStart=/usr/bin/python3 /usr/local/bin/thumbkeys.py

# Unbuffered stdout/stderr logging so journalctl captures prints immediately
Environment=PYTHONUNBUFFERED=1

# Auto-restart on device disconnects, unhandled errors, or unexpected crashes
Restart=on-failure
RestartSec=3s

# Security Hardening
# Prevent process from elevating privileges via suid/sgid bits
NoNewPrivileges=true
# Protect system paths from accidental modification
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target